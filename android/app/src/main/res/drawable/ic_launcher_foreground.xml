    <path
        android:pathData="M60,44
            m-3,0
            a3,3 0,1,0 6,0
            a3,3 0,1,0 -6,0"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.90" />

    <!-- ── Small secondary sparkle ── -->
    <path
        android:pathData="M64,49
            m-1.5,0
            a1.5,1.5 0,1,0 3,0
            a1.5,1.5 0,1,0 -3,0"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.70" />

    <!-- ── Upper eyelashes (bold curved strokes) ── -->
    <!-- Centre-left lash -->
    <path
        android:pathData="M40,42 C38,34 36,28 34,24"
        android:strokeColor="#C084FC"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />
    <!-- Centre lash -->
    <path
        android:pathData="M54,40 C54,32 54,26 54,22"
        android:strokeColor="#C084FC"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />
    <!-- Centre-right lash -->
    <path
        android:pathData="M68,42 C70,34 72,28 74,24"
        android:strokeColor="#C084FC"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />
    <!-- Far-left lash -->
    <path
        android:pathData="M28,49 C24,43 22,38 20,33"
        android:strokeColor="#A855F7"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />
    <!-- Far-right lash -->
    <path
        android:pathData="M80,49 C84,43 86,38 88,33"
        android:strokeColor="#A855F7"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />

    <!-- ── Lower lid outline ── -->
    <path
        android:pathData="M18,54 C24,70 84,70 90,54"
