<?xml version="1.0" encoding="utf-8"?>
<!--
    AnimeIn launcher foreground — stylized anime eye
    Canvas: 108×108 dp (standard adaptive icon safe zone: ~72×72 dp centered)
    The eye artwork is placed roughly between x=18..90, y=28..80
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ── Outer eye white (almond shape) ── -->
    <path
        android:pathData="M18,54
            C24,38 84,38 90,54
            C84,70 24,70 18,54 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.95" />

    <!-- ── Upper eyelid shadow gradient fill ── -->
    <path
        android:pathData="M18,54
            C24,38 84,38 90,54
            C74,44 34,44 18,54 Z"
        android:fillColor="#8B5CF6"
        android:fillAlpha="0.40" />

    <!-- ── Iris (large circle, neon purple) ── -->
    <path
        android:pathData="M54,54
            m-18,0
            a18,18 0,1,0 36,0
            a18,18 0,1,0 -36,0"
        android:fillColor="#7C3AED" />

    <!-- ── Iris inner rim (lighter) ── -->
    <path
        android:pathData="M54,54
            m-13,0
            a13,13 0,1,0 26,0
            a13,13 0,1,0 -26,0"
        android:fillColor="#9F67FF" />

    <!-- ── Pupil (black centre) ── -->
    <path
        android:pathData="M54,54
            m-9,0
            a9,9 0,1,0 18,0
            a9,9 0,1,0 -18,0"
        android:fillColor="#0D0620" />

